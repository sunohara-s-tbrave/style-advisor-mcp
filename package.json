{
  "name": "style-advisor-mcp",
  "version": "0.1.0",
  "description": "Self-reported body/style features in, reasoned outfit recommendations out — a rule-based MCP server.",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "bin": {
    "style-advisor-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "inspector": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "web:install": "npm install --prefix web",
    "web": "npm run build && npm run build --prefix web && npm start --prefix web"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/inspector": "^2.8.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^5.0.2"
  }
}
